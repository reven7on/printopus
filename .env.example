# Local PostgreSQL from compose.yaml
DATABASE_URL="postgresql://printopus:printopus@localhost:5432/printopus?schema=public"

# Public URL used for canonical, sitemap and Open Graph metadata
NEXT_PUBLIC_SITE_URL="https://printservice.by"

# Admin panel credentials. Replace every value outside local development.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
