# Local PostgreSQL from compose.yaml
DATABASE_URL="postgresql://printopus:printopus@localhost:5432/printopus?schema=public"

# Public URL used for canonical, sitemap and Open Graph metadata
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin panel credentials. Replace every value outside local development.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-locally"
ADMIN_SESSION_SECRET="local-development-session-secret-change-me"

# Telegram variables for running the app directly with npm.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_MANAGER_USER_IDS=""
TELEGRAM_WEBHOOK_SECRET=""

# Optional Docker Compose Telegram profile. Always use a separate test bot;
# the LOCAL_ prefix prevents accidental use of production credentials.
LOCAL_TELEGRAM_BOT_TOKEN=""
LOCAL_TELEGRAM_ADMIN_CHAT_ID=""
LOCAL_TELEGRAM_MANAGER_USER_IDS=""

# Private local storage for customer designs. Production overrides this inside Docker.
UPLOAD_DIR=".data/uploads"
UPLOAD_MIN_FREE_BYTES="0"
