# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.23.3-alpine3.24

FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN --mount=type=cache,target=/root/.npm npm ci

FROM dependencies AS builder
WORKDIR /app
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
COPY . .
RUN npm run build

FROM dependencies AS render-runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=10000 \
    UPLOAD_DIR=/var/lib/printopus/uploads

RUN apk add --no-cache fontconfig font-noto font-liberation font-liberation-sans-narrow font-urw-base35 \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs \
    && npm prune --omit=dev \
    && mkdir -p /var/lib/printopus/uploads \
    && chown -R nextjs:nodejs /var/lib/printopus /app \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --chown=nextjs:nodejs app/pricing.ts app/site-config.ts ./app/
COPY --chown=nextjs:nodejs lib ./lib
COPY --chown=nextjs:nodejs scripts/configure-telegram-webhook.mjs ./scripts/configure-telegram-webhook.mjs
COPY --chown=nextjs:nodejs scripts/render-start.sh ./scripts/render-start.sh
COPY --chown=nextjs:nodejs scripts/telegram-delivery-worker.ts ./scripts/telegram-delivery-worker.ts

USER nextjs
EXPOSE 10000
CMD ["sh", "scripts/render-start.sh"]
