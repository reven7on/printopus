# Optional. Copy to /srv/printopus/crm/.env and chmod 0600.
COMPOSE_PROJECT_NAME=printopus-crm
EDGE_NETWORK=printopus-edge

# Keep version tags pinned. Update them deliberately after testing on a clone.
ESPOCRM_IMAGE=espocrm/espocrm:10.0.8
MARIADB_IMAGE=mariadb:11.8.9-noble
ESPOCRM_SITE_URL=https://crm.printservice.by
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=replace-with-a-long-random-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
