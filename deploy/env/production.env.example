# Copy to /srv/printopus/production/.env, replace every placeholder, then chmod 0600.
COMPOSE_PROJECT_NAME=printopus-production
DEPLOYMENT_ENV=production
EDGE_NETWORK=printopus-edge
DOCKERHUB_NAMESPACE=replace-with-private-dockerhub-namespace
IMAGE_TAG=replace-with-immutable-release-tag

SITE_URL=https://printservice.by
POSTGRES_PASSWORD=replace-with-a-unique-long-random-database-password
DATABASE_URL=postgresql://printopus:replace-with-a-unique-long-random-database-password@database:5432/printopus?schema=public
UPLOADS_PATH=/srv/printopus/production/uploads
UPLOAD_MIN_FREE_BYTES=1073741824

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-random-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Do not reuse the staging bot: Telegram permits one webhook per bot.
TELEGRAM_BOT_TOKEN=replace-with-production-botfather-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-production-manager-chat-id
TELEGRAM_WEBHOOK_SECRET=replace_with_a_production_webhook_secret_of_16_or_more_characters
# Required for a group chat. Comma-separated Telegram numeric user IDs allowed
# to press order status buttons. May be empty only for a private one-to-one chat.
TELEGRAM_MANAGER_USER_IDS=
