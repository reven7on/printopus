# Store the real copy at /etc/printopus/restic.env (chmod 0600), never in Git.
# The backup script sources this file before invoking Restic.
RESTIC_REPOSITORY=s3:https://s3.example-provider.invalid/printopus-backups
RESTIC_PASSWORD_FILE=/etc/printopus/restic-password

# Set these according to the selected S3-compatible provider.
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_DEFAULT_REGION=us-east-1
# RESTIC_REST_USERNAME=  # only for a rest-server backend
# RESTIC_REST_PASSWORD=
