# Copy to /srv/printopus/staging/.env, replace every placeholder, then chmod 0600.
COMPOSE_PROJECT_NAME=printopus-staging
DEPLOYMENT_ENV=staging
EDGE_NETWORK=printopus-edge
DOCKERHUB_NAMESPACE=replace-with-private-dockerhub-namespace
IMAGE_TAG=replace-with-immutable-release-tag

SITE_URL=https://beta.printservice.by
POSTGRES_PASSWORD=replace-with-a-unique-long-random-database-password
DATABASE_URL=postgresql://printopus:replace-with-a-unique-long-random-database-password@database:5432/printopus?schema=public
UPLOADS_PATH=/srv/printopus/staging/uploads
UPLOAD_MIN_FREE_BYTES=1073741824

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-random-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Use a separate bot and a separate webhook secret from production.
TELEGRAM_BOT_TOKEN=replace-with-staging-botfather-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-staging-manager-chat-id
TELEGRAM_WEBHOOK_SECRET=replace_with_a_staging_webhook_secret_of_16_or_more_characters
# Required for a group chat; may be empty only for a private one-to-one chat.
TELEGRAM_MANAGER_USER_IDS=
