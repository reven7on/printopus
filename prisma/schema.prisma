generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductKind {
  SHIRT
  HOODIE
  POLO
  CAP
  BAG
}

enum ProductOptionType {
  COLOR
  SIZE
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

enum ContactMethod {
  PHONE
  TELEGRAM
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  kind        ProductKind
  description String?
  basePrice   Decimal         @db.Decimal(10, 2)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  options     ProductOption[]
  orderItems  OrderItem[]

  @@index([active, sortOrder])
  @@map("products")
}

model ProductOption {
  id         String            @id @default(uuid()) @db.Uuid
  productId  String            @db.Uuid
  type       ProductOptionType
  value      String
  label      String
  colorHex   String?
  priceDelta Decimal           @default(0) @db.Decimal(10, 2)
  active     Boolean           @default(true)
  sortOrder  Int               @default(0)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, value])
  @@index([productId, type, active, sortOrder])
  @@map("product_options")
}

model PrintMethod {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  description String?
  priceDelta  Decimal     @db.Decimal(10, 2)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  orderItems  OrderItem[]

  @@index([active, sortOrder])
  @@map("print_methods")
}

model PrintFormat {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique
  widthCm    Decimal     @db.Decimal(6, 2)
  heightCm   Decimal     @db.Decimal(6, 2)
  priceDelta Decimal     @db.Decimal(10, 2)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@index([active, sortOrder])
  @@map("print_formats")
}

model VolumeDiscount {
  id          String  @id @default(uuid()) @db.Uuid
  minQuantity Int     @unique
  percent     Decimal @db.Decimal(5, 2)
  active      Boolean @default(true)

  @@index([active, minQuantity])
  @@map("volume_discounts")
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  orderNumber       String            @unique
  status            OrderStatus       @default(NEW)
  customerName      String
  customerPhone     String
  contactMethod     ContactMethod     @default(PHONE)
  fulfillmentMethod FulfillmentMethod @default(PICKUP)
  deliveryAddress   String?
  comment           String?
  currency          String            @default("BYN") @db.Char(3)
  subtotal          Decimal           @db.Decimal(12, 2)
  discountPercent   Decimal           @default(0) @db.Decimal(5, 2)
  total             Decimal           @db.Decimal(12, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             OrderItem[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  productId     String?       @db.Uuid
  printMethodId String?       @db.Uuid
  printFormatId String?       @db.Uuid
  productName   String
  colorLabel    String?
  sizeLabel     String?
  placement     String?
  quantity      Int
  baseUnitPrice Decimal       @db.Decimal(10, 2)
  unitPrice     Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(12, 2)
  design        Json?
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  printMethod   PrintMethod?  @relation(fields: [printMethodId], references: [id], onDelete: SetNull)
  printFormat   PrintFormat?  @relation(fields: [printFormatId], references: [id], onDelete: SetNull)
  assets        DesignAsset[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model DesignAsset {
  id           String    @id @default(uuid()) @db.Uuid
  orderItemId  String    @db.Uuid
  originalName String
  storageKey   String    @unique
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("design_assets")
}
