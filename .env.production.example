# Compatibility template for compose.production.yaml. Prefer deploy/env/*.env.example.
COMPOSE_PROJECT_NAME="printopus-production"
DEPLOYMENT_ENV="production"
EDGE_NETWORK="printopus-edge"
DOCKERHUB_NAMESPACE="replace-with-private-dockerhub-namespace"
IMAGE_TAG="replace-with-immutable-release-tag"
SITE_URL="https://printservice.by"

# PostgreSQL is available only inside the private Docker network.
POSTGRES_PASSWORD="replace-with-a-long-random-database-password"
DATABASE_URL="postgresql://printopus:replace-with-a-long-random-database-password@database:5432/printopus?schema=public"

# Replace all values before the first production start.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Telegram Bot API. Generate the webhook secret with: openssl rand -hex 32
TELEGRAM_BOT_TOKEN="replace-with-botfather-token"
TELEGRAM_ADMIN_CHAT_ID="replace-with-manager-chat-id"
TELEGRAM_WEBHOOK_SECRET="replace_with_a_random_webhook_secret"
# Comma-separated Telegram numeric user IDs. Required for a group chat; it may
# be empty only when TELEGRAM_ADMIN_CHAT_ID is a private one-to-one chat.
TELEGRAM_MANAGER_USER_IDS=""

# The production container maps this host directory to its private upload path.
UPLOADS_PATH="/srv/printopus/production/uploads"
UPLOAD_MIN_FREE_BYTES="1073741824"
