# Domain whose DNS A/AAAA records point to the VPS.
SITE_DOMAIN="printservice.by"
NEXT_PUBLIC_SITE_URL="https://printservice.by"

# PostgreSQL is available only inside the private Docker network.
POSTGRES_PASSWORD="replace-with-a-long-random-database-password"
DATABASE_URL="postgresql://printopus:replace-with-a-long-random-database-password@database:5432/printopus?schema=public"

# Replace all values before the first production start.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# The production container always maps this to /srv/printopus/uploads on the VPS.
UPLOAD_DIR="/var/lib/printopus/uploads"
UPLOAD_MIN_FREE_BYTES="1073741824"
